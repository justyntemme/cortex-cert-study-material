  rankdir=TB;
  request [label="Authenticated API request
normalize query + credentials"];
  cache [label="Full-result cache?",shape=diamond,fillcolor="#f5ecd8"];
  engine [label="Gold match or deterministic compiler"];
  ai [label="Cognitive fallback
